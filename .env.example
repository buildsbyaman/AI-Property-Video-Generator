# AI Property Video Generator Configuration
# Copy this file to .env and fill in values as needed

# Optional: Enables AI script mode (falls back to deterministic templates if missing or invalid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Text-to-Speech settings
ENABLE_TTS=true

# Upload limits
MAX_UPLOAD_MB=8

# Server settings
HOST=127.0.0.1
PORT=8000
